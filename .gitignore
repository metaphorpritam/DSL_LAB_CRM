# ── Python-generated files ───────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── CatBoost training artifacts ──────────────────────────────────────────────
catboost_info/

# ── R history ────────────────────────────────────────────────────────────────
.Rhistory

# ── Secrets / credentials (Google service account, etc.) ─────────────────────
secrets/
*.pem

# ── Generated outputs & reports (regenerate by running the notebooks) ────────
