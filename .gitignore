Output/
reports/

# ── LaTeX build artifacts ────────────────────────────────────────────────────
*.aux
*.toc
*.out
*.synctex.gz

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
~$*
